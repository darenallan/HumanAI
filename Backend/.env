# ==============================================================================
# Configuration de la Plateforme IA RH - Ydays 2026
# ==============================================================================

# Mode debug (true = logs SQL, mock auth autorisé)
DEBUG=true

# ==============================================================================
# Base de données PostgreSQL
# ==============================================================================
# Format async (utilisé par FastAPI / SQLAlchemy async)
DATABASE_URL=sqlite+aiosqlite:///humanai.db
# Format sync (utilisé par Alembic / scripts utilitaires)
DATABASE_URL_SYNC=sqlite+pysqlite:///humanai.db

# ==============================================================================
# Redis (cache, sessions, rate-limiting)
# ==============================================================================
REDIS_URL=redis://localhost:6379/0

# ==============================================================================
# JWT (Tokens d'accès et de rafraîchissement)
# ==============================================================================
JWT_SECRET_KEY=dev-secret-change-in-production-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ==============================================================================
# Chiffrement des données sensibles (AES-256 / pgcrypto)
# ==============================================================================
# DOIT faire 32 caractères en production
APP_ENCRYPTION_KEY=dev-key-change-me-32-chars-min!!

# ==============================================================================
# Firebase Authentication
# ==============================================================================
FIREBASE_CREDENTIALS_PATH=firebase-credit-access.json
FIREBASE_PROJECT_ID=humanai-ydays-2026

# ==============================================================================
# Intelligence Artificielle (RAG / LLM)
# ==============================================================================
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# ==============================================================================
# MinIO (stockage objets — documents générés, sources RAG)
# ==============================================================================
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=humanai_minio
MINIO_ROOT_PASSWORD=CHANGE_ME_minio_password
MINIO_BUCKET_DOCUMENTS=humanai-documents
MINIO_BUCKET_RAG=humanai-rag-sources

# ==============================================================================
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:3002,http://127.0.0.1:3002,http://localhost:8000,http://127.0.0.1:8000

