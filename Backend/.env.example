# ================================================
# .env.example — HumaNai Local Environment
# ================================================
# Copiez ce fichier en .env et renseignez vos valeurs locales :
#   cp .env.example .env
#
# ⚠️  Le fichier .env ne doit JAMAIS être commité dans Git.
# ================================================

# Mode debug (true = logs SQL, mock auth autorisé)
DEBUG=true

# --- PostgreSQL ---
DATABASE_URL=postgresql+asyncpg://humanai_user:CHANGE_ME_strong_password@localhost:5432/humanai_db
DATABASE_URL_SYNC=postgresql+psycopg2://humanai_user:CHANGE_ME_strong_password@localhost:5432/humanai_db

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- JWT ---
JWT_SECRET_KEY=CHANGE_ME_openssl_rand_hex_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Chiffrement (pgcrypto / AES-256) ---
# Doit faire exactement 32 caractères en production
APP_ENCRYPTION_KEY=CHANGE_ME_32_chars_minimum_key!!

# --- Firebase ---
FIREBASE_CREDENTIALS_PATH=firebase-credit-access.json
FIREBASE_PROJECT_ID=humanai-ydays-2026
# NE PAS mettre la clé Firebase directement ici — utiliser le fichier JSON

# --- Intelligence Artificielle ---
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-CHANGE_ME
ANTHROPIC_API_KEY=sk-ant-CHANGE_ME
EMBEDDING_MODEL=text-embedding-3-small

# --- MinIO (stockage objets) ---
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=humanai_minio
MINIO_ROOT_PASSWORD=CHANGE_ME_minio_password
MINIO_BUCKET_DOCUMENTS=humanai-documents
MINIO_BUCKET_RAG=humanai-rag-sources

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173